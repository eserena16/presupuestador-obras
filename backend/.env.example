# Copiar como .env y completar los valores

# Base de datos
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/presupuestador

# Seguridad JWT
SECRET_KEY=cambia-esto-por-una-clave-muy-larga-y-random-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (frontend URL)
FRONTEND_URL=http://localhost:5173

# Entorno
ENVIRONMENT=development
